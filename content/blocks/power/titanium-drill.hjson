type: AttributeCrafter

name: "钛矿钻井"
description: "消耗大量电力，在地热区域钻取钛矿。"

size: 3
health: 120
category: production

// 逻辑设定：完美实现属性检测
attribute: cryothermal
baseEfficiency: 0.0
minEfficiency: 9.0
boostScale: 0.1111
craftTime: 220.0

hasPower: true
hasItems: true

consumes: {
  power: 4.5
}

outputItem: titanium/9

drawer: {
  type: DrawMulti
  drawers: [
    {
      // 1. 最底层：默认绘制底座（titanium-drill.png）
      type: DrawDefault
    }
    {
      // 2. 中间层：使用 DrawRegion 配合 spinSprite: true 让其旋转
      type: DrawRegion
      suffix: "-rotator"
      // 开启旋转
      spinSprite: true
      // 旋转速度（正数顺时针，负数逆时针）
      rotateSpeed: 2.0
    }
    {
      // 3. 最顶层：覆盖静态盖子（titanium-drill-top.png）
      type: DrawRegion
      suffix: "-top"
    }
  ]
}
// =============================================================

requirements: [
  aluminum/80
  magnesium/40
  scrap/80
  silicon/50
  graphite/50
]

research: {
  parent: melting-drill
  requirements: [
    aluminum/700
    magnesium/300
    scrap/500
    graphite/500
    silicon/500
  ]
  objectives: [
    {
      type: Produce
      content: scrap
    }
    {
      type: Produce
      content: graphite
    }
  ]
}

shownPlanets: [cryon]