type: mech
name: "天冠"

# ---- 基础属性 (T5 数值) ----
speed: 0.46
flying: false
health: 34000
armor: 26
hitSize: 32
faceTarget: true

# ---- 外观颜色 ----
outlineColor: 787886
mechLegColor: 787886

# ---- 辅助与建造功能 ----
buildSpeed: 1.6
canBoost: true
boostMultiplier: 1.4
buildBeamOffset: 6
engineOffset: 12
engineSize: 7

abilities: [
  {
    type: RepairFieldAbility
    range: 110
    amount: 22
    reload: 70
  }
]

weapons: [
  # 1. 核心主炮 (正前方 1 门)
  {
    name: bolide-missile-mount
    top: true
    x: 0
    y: 14
    rotate: true
    mirror: false
    reload: 150
    shootCone: 15
    shootSound: shootMissile

    shootWarmupSpeed: 0.05
    minWarmup: 0.9

    parts: [
      { type: RegionPart, suffix: "-left", progress: reload, moveX: -6, moveY: 0 }
      { type: RegionPart, suffix: "-right", progress: reload, moveX: 6, moveY: 0 }
    ]

    bullet: {
      instantDisappear: true
      damage: 0
      spawnUnit: doom-missile
      shootEffect: {
        type: MultiEffect
        effects: [
          { type: ParticleEffect, line: false, particles: 8, lifetime: 110, sizeFrom: 20, sizeTo: 0, length: 50, cone: 360, colorFrom: "8a4212ff", colorTo: "8a421200" }
          { type: ParticleEffect, line: false, particles: 18, lifetime: 25, sizeFrom: 12, sizeTo: 2, length: 55, cone: 15, colorFrom: ffa64d, colorTo: ff4d00, rotWithParent: true, baseRotation: 180 }
        ]
      }
    }
  },

