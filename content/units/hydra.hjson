          { type: ParticleEffect, line: false, particles: 15, lifetime: 25, sizeFrom: 12, sizeTo: 2, length: 50, cone: 15, colorFrom: ffa64d, colorTo: ff4d00, rotWithParent: true, baseRotation: 180 }
        ]
