#the mod name as displayed in-game
displayName: "Cryon Core"

#the internal name of your mod
name: "cryon-java-dependency"
#Changing this ID may cause an error.
#your name
author: "Bowen-H0"

#the fully qualified main class of the mod
main: "example.ExampleJavaMod"

#the mod description as seen in the mod dialog

description: '''
[#7ec8e3]Cryon[] adds a brand new frozen planet to the game.

You can carry resources to other sectors, just like in [accent]Serpulo[].

Over [accent]100+[] new pieces of content! Including new ores, new machines, and new units.

Current development progress: [accent]T1 ~ T3 tech[] is complete. The campaign is currently being tested.

[accent]Thanks for playing this mod!
Feel free to report issues or suggest ideas: [lightgray]github bowen-H0[]

Supported languages: [cyan]English[] / [cyan]中文[]

Your mod browser will usually handle dependencies automatically.
dependencies: Cryon
This mod is currently in testing.
'''
#the mod version
version: 15.1.0
#the minimum game build required to run this mod
minGameVersion: 154

#this is a java mod
java: true
#cryon-java-dependency is not a dependency; cryon is a dependency of cryon-java-dependency.
#cryon-java-dependency is the main package.
dependencies: [
  "cryon"
]