#the mod name as displayed in-game
displayName: "Cryon Core"

#the internal name of your mod
name: "cryon-java-dependency"
#Changing this ID may cause an error.
#your name
author: "Bowen-H0"

#the fully qualified main class of the mod
main: "example.ExampleJavaMod"

#the mod description as seen in the mod dialog
description: "Cryon Mod."

#the mod version
version: 15.0.0
#the minimum game build required to run this mod
minGameVersion: 154

#this is a java mod
java: true
#cryon-java-dependency is not a dependency; cryon is a dependency of cryon-java-dependency.
#cryon-java-dependency is the main package.
dependencies: [
  "cryon"
]